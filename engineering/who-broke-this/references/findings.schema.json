{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Codex review findings",
  "type": "object",
  "required": ["findings"],
  "additionalProperties": false,
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "line", "severity", "title", "description", "failure_scenario"],
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string",
            "description": "Repo-relative path of the file the finding is in"
          },
          "line": {
            "type": "integer",
            "minimum": 1,
            "description": "Line number on the new side of the diff"
          },
          "severity": {
            "enum": ["critical", "major", "minor"]
          },
          "title": {
            "type": "string",
            "maxLength": 80,
            "description": "One-line summary of the defect"
          },
          "description": {
            "type": "string",
            "description": "What is wrong and why"
          },
          "failure_scenario": {
            "type": "string",
            "description": "Concrete input or state that triggers the failure"
          },
          "suggested_fix": {
            "type": "string",
            "description": "Optional: how to fix it"
          }
        }
      }
    }
  }
}
